machine sm_120

# The same kernel, claiming an intensity it does not have.
# 2.0 flop/byte would be near the ridge; the body computes 0.1667.
kernel saxpy_lie(n: u32, a: f32, x: [f32], y: [f32])
    intensity 2.0

    stream x : dram -> reg
    stream y : dram -> reg, drain

    at reg:
        y = a * x + y
