machine sm_120

# The other half of the same investigation, and this one came back clean.
#
# x - x is 0 for every finite x, so x / (x - x) is +inf or -inf by the sign of x, and NaN
# where x is exactly 0 -- which the input generator produces 14 times in 65536 elements. The
# reduction therefore combines NaN with both infinities.
#
# Host and device agreed bit for bit: both return the non-NaN operand rather than propagating
# the NaN, and the reduction comes out +inf. Measured, not assumed -- ADR-0013 refused to
# state it until this ran.
kernel not_a_number(n: u32, x: [f32], partial: [f32])
    intensity 0.5

    stream x : dram -> reg
    reduce max m : reg -> smem -> dram into partial

    at reg:
        m = x / (x - x)
